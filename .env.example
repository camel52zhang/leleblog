# ===== 后端安全配置（生产环境务必修改为强随机值） =====

# JWT 签名密钥：必填项。缺失会导致后端启动失败（fail-fast）。
# 生成方式： openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# 管理员初始密码（可选）。留空则自动生成随机密码，并强制首次登录改密。
ADMIN_PASSWORD=

# 允许跨域访问的前端来源，多个用逗号分隔。
# 需包含浏览器实际访问前端的地址（本地开发为 http://localhost:4000）。
ALLOWED_ORIGINS=http://localhost:4000,http://leleblog-web:4000

# 数据库与上传目录（容器内路径，一般无需修改）
DB_PATH=/data/leleblog.db
UPLOAD_DIR=/data/uploads

# ===== 邮件服务（SMTP）配置（可选，用于真实发送「找回密码」验证码） =====
# 全部留空 = 不发邮件，验证码仅打印到后端日志（本地开发）。
# 填写后重启后端即可真实发信。注意 QQ/163 等需用「授权码」而非登录密码。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=你的邮箱@qq.com
# SMTP_PASSWORD=你的授权码
# SMTP_FROM=你的邮箱@qq.com
# SMTP_USE_SSL=true          # 465 端口填 true；587 等 STARTTLS 端口填 false

# ===== 前端配置（仅构建时生效） =====

# 后端 API 地址。本地开发可设为 http://localhost:7070
NEXT_PUBLIC_API_URL=http://leleblog-api:7070
